# Debug Mode
START_RESTART_DEBUG_MSG="\033[1;33mDebug mode enabled. RAM logging and .health file generation by Python will be active.\033[0m"
START_RESTART_VENV_ACTIVATION="Activating venv environment..."

# Window Titles
START_RESTART_TITLE_MODE_SELECT="Select Mail Backend Mode"
START_RESTART_TITLE_POLLING_INTERVAL="Polling – check interval (seconds)?"
START_RESTART_TITLE_ALREADY_RUNNING="Zupix-Py2Lua-Mail-conky – already running!"
START_RESTART_TITLE_RESTART_CONFIRM="Restart Conky Mail"
START_RESTART_TITLE_VENV_FIX="Auto-repair venv"

# Mode Selection (IDLE/POLLING)
START_RESTART_BTN_IDLE="IDLE (listening mode)"
START_RESTART_BTN_POLLING="POLLING (cyclic check)"
START_RESTART_TEXT_MODE_DESC="<big><b>How should the mail backend check for new emails?</b></big>\n\n<b><span foreground='green'>IDLE</span> Mode:</b>\n• Connects to IMAP server, listening for server notifications (IDLE interrupts).\n• Checks changes and generates new cache upon notification.\n• <b>Lower RAM/CPU usage</b>, recommended if you want fewer server requests and don't need instant notifications.\n\n<b><span foreground='red'>POLLING</span> Mode:</b>\n• Every X seconds (you will set it in a moment) it downloads all unread messages from mail server and generates new cache.\n• <b>Instant notifications in conky window, in every cycle (every X seconds)</b>.\n• Good if you need immediate reaction, but not recommended if your mail provider dislikes frequent requests.\n\n<b>Select mode:</b>\n<b>IDLE</b> – <i>listens for server changes</i>  |  <b>POLLING</b> – <i>checks manually every few seconds</i>"
START_RESTART_TEXT_POLLING_ENTRY="Enter number of seconds for update interval (e.g. 5, 10, 30):"
START_RESTART_ERR_INVALID_INT="❗ Value \"%s\" is not an integer greater than zero! Script aborted."
START_RESTART_INFO_NO_MODE="❗ No mode selected. Script aborted."

# Notifications (Notify-send)
START_RESTART_NOTIFY_IDLE_SET="⚡ IDLE mode set"
START_RESTART_NOTIFY_IDLE_DESC="Backend will run in IMAP IDLE mode"
START_RESTART_NOTIFY_POLLING_SET="⏳ POLLING mode set"
START_RESTART_NOTIFY_POLLING_DESC="Backend will check emails every %s seconds, cache write every %s seconds"
START_RESTART_NOTIFY_ALREADY_RUNNING="ℹ️ Already running"
START_RESTART_NOTIFY_ALREADY_DESC="Script is already running in background. Second instance won't start."
START_RESTART_NOTIFY_SHUTDOWN_OK="✅ Stopped"
START_RESTART_NOTIFY_SHUTDOWN_DESC="Processes terminated successfully."
START_RESTART_NOTIFY_RESTARTING="🔁 Restarting!"
START_RESTART_NOTIFY_RESTART_DESC="Relaunching..."
START_RESTART_NOTIFY_STOPPED="🛑 Finished"
START_RESTART_NOTIFY_STOPPED_DESC="Not restarting. Everything closed."
START_RESTART_NOTIFY_MISSING_FILE="❗ Missing file"
START_RESTART_NOTIFY_MISSING_DESC="File %s not found. Script terminating."
START_RESTART_NOTIFY_RAM_LIMIT="⚠️ Restart Conky"
START_RESTART_NOTIFY_RAM_DESC="conkyrc_zupix PID %s exceeded %s MB RAM. Restarting..."
START_RESTART_NOTIFY_VENV_ACTIVATE="🐍 Virtualenv"
START_RESTART_NOTIFY_VENV_DESC="Activating Python venv environment..."
START_RESTART_NOTIFY_PYTHON_START="▶️ Starting Python"
START_RESTART_NOTIFY_PYTHON_DESC="Running script %s"
START_RESTART_NOTIFY_WAITING="⏳ Waiting"
START_RESTART_NOTIFY_WAITING_DESC="Waiting for %s creation by Python..."
